---
import { site } from '../data/site';
import { getGitHubData } from '../lib/github';
import { relativeTime, langColor, eventGlyph, eventVerb } from '../lib/format';

const data = await getGitHubData();
const latest = data.repos[0];
const recent = data.events.slice(0, 4);
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="hero__cmd mono">
        <span class="hero__dollar">$</span> whoami
      </p>

      <h1 class="hero__name">{site.name}</h1>

      <!-- The first role is server-rendered so it is present with JS off and
           for crawlers; live.ts cycles it from data-roles. -->
      <p class="hero__role mono">
        <span class="hero__role-text" data-roles={JSON.stringify(site.roles)}>{site.role}</span
        ><span class="hero__role-caret" aria-hidden="true"></span>
        <span class="hero__sep">/</span>
        <span class="hero__loc">{site.location}</span>
      </p>

      <p class="hero__tagline">{site.tagline}</p>

      {
        site.availableForWork && (
          <p class="hero__status mono">
            <span class="hero__pulse" aria-hidden="true" />
            {site.availabilityNote}
          </p>
        )
      }

      <div class="hero__actions">
        <a href="#projects" class="btn btn--primary mono">
          view work <span aria-hidden="true">→</span>
        </a>
        <a href={`mailto:${site.email}`} class="btn mono">get in touch</a>
        {
          site.links.resume && (
            <a href={site.links.resume} class="btn mono" target="_blank" rel="noopener">
              résumé
            </a>
          )
        }
      </div>

      <p class="hero__hint mono">
        press <kbd>Ctrl</kbd>+<kbd>K</kbd> for the terminal
      </p>
    </div>

    <!-- Live pane. Rendered with build-time data, then patched in the browser
         by live.ts so it reflects the last few minutes, not the last deploy. -->
    <aside class="term" aria-label="Live GitHub activity">
      <div class="term__bar">
        <span class="term__dots" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
        <span class="term__title mono">arnav@github — live</span>
        <span class="term__live mono" data-live-badge data-state={data.live ? 'live' : 'cached'}>
          <span class="term__live-dot"></span>
          <span data-live-label>{data.live ? 'live' : 'cached'}</span>
        </span>
      </div>

      <div class="term__body mono">
        <p class="term__line">
          <span class="term__dollar">$</span> gh repo list --sort pushed --limit 1
        </p>

        {
          latest && (
            <a class="term__repo" href={latest.html_url} target="_blank" rel="noopener">
              <span class="dot" style={`--dot:${langColor(latest.language)}`} />
              <span class="term__repo-name">{latest.name}</span>
              <span class="term__repo-time" data-relative={latest.pushed_at}>
                {relativeTime(latest.pushed_at)}
              </span>
            </a>
          )
        }

        <p class="term__line term__line--spaced">
          <span class="term__dollar">$</span> gh activity --tail
        </p>

        <ul class="term__events" data-hero-events>
          {
            recent.map((e) => (
              <li class="term__event">
                <span class="term__glyph">{eventGlyph(e.type)}</span>
                <span class="term__event-text">
                  {eventVerb(e.type)} <b>{e.repo}</b>
                  {e.detail && <i> · {e.detail}</i>}
                </span>
                <span class="term__event-time" data-relative={e.created_at}>
                  {relativeTime(e.created_at)}
                </span>
              </li>
            ))
          }
        </ul>

        <p class="term__line term__line--spaced term__cursor">
          <span class="term__dollar">$</span> <span class="term__blink"></span>
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 10vh, 7rem) clamp(3rem, 8vh, 5rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* ---------- left ---------- */

  .hero__cmd {
    font-size: 0.85rem;
    color: var(--fg-faint);
    margin-bottom: 1rem;
  }

  .hero__dollar {
    color: var(--accent);
    margin-right: 0.4rem;
  }

  .hero__name {
    margin-bottom: 0.7rem;
    background: linear-gradient(170deg, #ffffff 20%, #9fb4b8 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__role {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    color: var(--accent);
    margin-bottom: 1.6rem;
  }

  /* Reserve the width of the longest role so the location doesn't slide around
     as the text types in and out. */
  .hero__role-text {
    display: inline-block;
    min-width: 0;
  }

  .hero__role-caret {
    display: inline-block;
    width: 7px;
    height: 0.95em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: role-blink 1.1s steps(1) infinite;
  }

  @keyframes role-blink {
    50% {
      opacity: 0;
    }
  }

  .hero__sep {
    color: var(--fg-faint);
    margin-inline: 0.5rem;
  }

  @media (max-width: 560px) {
    /* Stack the location below on narrow screens — the typing role plus a
       location on one line wraps mid-phrase otherwise. */
    .hero__sep {
      display: none;
    }

    .hero__loc {
      display: block;
    }
  }

  .hero__loc {
    color: var(--fg-dim);
  }

  .hero__tagline {
    max-width: 46ch;
    font-size: clamp(1rem, 1.4vw, 1.13rem);
    color: var(--fg-dim);
    margin-bottom: 1.8rem;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.85rem 0.35rem 0.75rem;
    font-size: 0.78rem;
    color: var(--accent);
    background: rgba(74, 222, 128, 0.07);
    border: 1px solid rgba(74, 222, 128, 0.25);
    border-radius: 999px;
    margin-bottom: 2rem;
  }

  .hero__pulse {
    position: relative;
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    flex: none;
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    animation: ping 2s var(--ease) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(0.6);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 1.6rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.83rem;
    color: var(--fg-dim);
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      background-color 0.2s var(--ease), transform 0.2s var(--ease);
  }

  .btn:hover {
    color: var(--fg);
    border-color: var(--line-2);
    transform: translateY(-1px);
  }

  .btn--primary {
    color: var(--bg);
    font-weight: 500;
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn--primary:hover {
    color: var(--bg);
    background: #6ee79a;
    border-color: #6ee79a;
  }

  .hero__hint {
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  /* ---------- right: terminal pane ---------- */

  .term {
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.85rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--line);
  }

  .term__dots {
    display: flex;
    gap: 6px;
  }

  .term__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg-3);
  }

  .term__dots i:first-child {
    background: #3d2b2e;
  }

  .term__title {
    flex: 1;
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  .term__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .term__live[data-state='live'] {
    color: var(--accent);
  }

  .term__live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .term__live[data-state='live'] .term__live-dot {
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .term__body {
    padding: 1.1rem 1rem 1.3rem;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .term__line {
    color: var(--fg-faint);
  }

  .term__line--spaced {
    margin-top: 1.1rem;
  }

  .term__dollar {
    color: var(--accent);
    margin-right: 0.45rem;
  }

  .term__repo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.5rem;
    padding: 0.5rem 0.6rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.2s var(--ease);
  }

  .term__repo:hover {
    border-color: var(--line-2);
  }

  .term__repo-name {
    flex: 1;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term__repo-time {
    color: var(--fg-faint);
    font-size: 0.72rem;
    flex: none;
  }

  .term__events {
    list-style: none;
    padding: 0;
    margin-top: 0.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .term__event {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--fg-dim);
  }

  .term__glyph {
    color: var(--cyan);
    flex: none;
    width: 0.9em;
  }

  .term__event-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .term__event-text b {
    color: var(--fg);
    font-weight: 500;
  }

  .term__event-text i {
    color: var(--fg-faint);
    font-style: normal;
  }

  .term__event-time {
    flex: none;
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  .term__blink {
    display: inline-block;
    width: 7px;
    height: 14px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: cursor 1.1s steps(1) infinite;
  }

  @keyframes cursor {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .term {
      order: 2;
    }
  }
</style>
