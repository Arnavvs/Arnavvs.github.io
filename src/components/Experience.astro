---
import { site } from '../data/site';

const roles = site.experience;
---

<section id="experience" class="section section--tight">
  <div class="wrap">
    <div class="section-head">
      <span class="section-head__num">02</span>
      <h2 class="section-head__title">Experience</h2>
      <span class="section-head__rule"></span>
    </div>

    <div class="exp">
      {
        roles.map((r) => (
          <article class="exp__card card" data-reveal>
            <header class="exp__head">
              <div class="exp__id">
                <h3 class="exp__company">{r.company}</h3>
                <p class="exp__role mono">{r.role}</p>
              </div>

              <div class="exp__side">
                <span class="exp__period mono">{r.period}</span>
                {r.confidential && (
                  <span class="exp__lock mono" title="Details withheld under NDA">
                    <svg
                      viewBox="0 0 16 16"
                      width="11"
                      height="11"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M8 1a3.5 3.5 0 0 0-3.5 3.5V6H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 5H6V4.5a2 2 0 1 1 4 0V6Z" />
                    </svg>
                    NDA
                  </span>
                )}
              </div>
            </header>

            <p class="exp__summary">{r.summary}</p>

            {r.metrics.length > 0 && (
              <ul class="exp__metrics">
                {r.metrics.map((m) => (
                  <li class="exp__metric">
                    <span class="exp__metric-value mono">{m.value}</span>
                    <span class="exp__metric-label mono">{m.label}</span>
                  </li>
                ))}
              </ul>
            )}

            {r.projects.map((proj) => (
              <div class="exp__proj">
                {proj.name && <h4 class="exp__proj-name mono">{proj.name}</h4>}
                <ul class="exp__points">
                  {proj.points.map((p) => (
                    <li class="exp__point">
                      <span class="exp__bullet mono" aria-hidden="true">
                        ›
                      </span>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            <ul class="exp__tech">
              {r.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section--tight {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(4rem, 9vw, 7rem);
  }

  .exp {
    display: grid;
    gap: 1rem;
  }

  .exp__card {
    padding: 1.6rem 1.6rem 1.4rem;
  }

  .exp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .exp__company {
    font-size: 1.15rem;
    margin-bottom: 0.2rem;
  }

  .exp__role {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .exp__side {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .exp__period {
    font-size: 0.74rem;
    color: var(--fg-faint);
  }

  .exp__lock {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    font-size: 0.63rem;
    letter-spacing: 0.1em;
    color: var(--amber);
    background: rgba(251, 191, 36, 0.07);
    border: 1px solid rgba(251, 191, 36, 0.28);
    border-radius: 999px;
  }

  .exp__summary {
    font-size: 0.92rem;
    color: var(--fg-dim);
    max-width: 72ch;
    margin-bottom: 1.2rem;
  }

  /* Numbers first — they are what a reader scans for, and they carry the
     weight the bullets used to carry in prose. */
  .exp__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-bottom: 1.4rem;
  }

  .exp__metric {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg-2);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .exp__metric-value {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .exp__metric-label {
    font-size: 0.66rem;
    color: var(--fg-dim);
  }

  /* Each workstream gets a rule + label so two projects under one employer
     don't read as one undifferentiated list of bullets. */
  .exp__proj + .exp__proj {
    margin-top: 1.3rem;
  }

  .exp__proj-name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--cyan);
    margin-bottom: 0.6rem;
  }

  .exp__proj-name::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--cyan);
    transform: rotate(45deg);
    flex: none;
  }

  .exp__points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .exp__point {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.5rem;
    font-size: 0.87rem;
    color: var(--fg-dim);
    max-width: 82ch;
  }

  .exp__bullet {
    color: var(--accent);
  }

  .exp__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin-top: 1.4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
  }
</style>
